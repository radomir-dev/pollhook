{
  "repos": [
    {
      "repo": "omnigame-studio/dev-server",
      "events": [
        "push",
        "create",
        "delete",
        "issues",
        "issue_comment",
        "release",
        "label",
        "milestone",
        "repository",
        "public",
        "fork",
        "commit_comment",
        "workflow_run",
        "check_suite",
        "check_run",
        "pull_request",
        "pull_request_review",
        "page_build",
        "status"
      ],
      "intervalSeconds": 30,
      "checkRefLimit": 5
    }
  ],
  "stateDir": "~/.local/state/pollhook"
}
