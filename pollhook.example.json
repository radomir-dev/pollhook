{
  "repos": [
    {
      "repo": "omnigame-studio/dev-server",
      "events": [
        "push",
        "create",
        "delete",
        "issues",
        "issue_comment",
        "release",
        "label",
        "milestone",
        "repository",
        "public",
        "fork",
        "commit_comment",
        "workflow_dispatch",
        "merge_group",
        "dependabot_alert",
        "code_scanning_alert",
        "secret_scanning_alert",
        "deployment",
        "deployment_status",
        "deploy_key",
        "repository_ruleset",
        "repository_advisory",
        "repository_vulnerability_alert",
        "security_and_analysis",
        "branch_protection_configuration",
        "member",
        "workflow_run",
        "check_suite",
        "check_run",
        "pull_request",
        "pull_request_review",
        "page_build",
        "status"
      ],
      "intervalSeconds": 30,
      "checkRefLimit": 5
    }
  ],
  "stateDir": "~/.local/state/pollhook"
}
