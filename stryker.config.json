{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.stryker.config.ts"
  },
  "mutate": [
    "src/**/*.ts",
    "!src/cli.ts",
    "!src/quiet.ts"
  ],
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "thresholds": {
    "high": 80,
    "low": 60
  },
  "tempDirName": ".stryker-tmp",
  "tsconfigFile": "tsconfig.stryker-none.json"
}
