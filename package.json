{
  "name": "pollhook",
  "version": "0.1.0",
  "type": "module",
  "description": "GitHub webhook deliveries without webhooks: a local listener fed by REST API polling",
  "bin": {
    "pollhook": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/cli.ts daemon",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "docs": "node scripts/cli-docs.ts",
    "docs:check": "node scripts/cli-docs.ts --check"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist"
  ]
}
