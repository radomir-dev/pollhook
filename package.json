{
  "name": "pollhook",
  "version": "0.10.0",
  "description": "GitHub webhook deliveries without webhooks: a local listener fed by REST API polling",
  "bin": {
    "pollhook": "./dist/cli.js"
  },
  "files": [
    "dist",
    "pollhook.schema.json"
  ],
  "type": "module",
  "scripts": {
    "start": "node src/cli.ts daemon",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "docs": "node scripts/cli-docs.ts",
    "docs:check": "node scripts/cli-docs.ts --check",
    "lint": "oxlint src test scripts",
    "format": "oxfmt",
    "format:check": "oxfmt --check src test scripts",
    "doctor": "node scripts/doctor.ts",
    "arch": "depcruise src test scripts --config .dependency-cruiser.cjs",
    "test:coverage": "vitest run --coverage",
    "mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.10",
    "@vitest/coverage-v8": "^5.1.2",
    "dependency-cruiser": "^18.9.0",
    "knip": "^6.48.0",
    "listr2": "^11.4.1",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radomir-dev/pollhook.git"
  },
  "homepage": "https://radomir.dev/pollhook/",
  "keywords": [
    "github",
    "webhook",
    "webhooks",
    "polling",
    "github-actions",
    "ci",
    "cli",
    "rest-api",
    "etag",
    "wait-for-ci",
    "gh-run-watch",
    "events"
  ],
  "bugs": {
    "url": "https://github.com/radomir-dev/pollhook/issues"
  }
}
